# Supabase project — Dojô Família Scholze
# Após T8 (criar project no dashboard Supabase), copie aqui:
#   - SUPABASE_URL: dashboard > Project Settings > API > Project URL
#   - SUPABASE_ANON_KEY: dashboard > Project Settings > API > anon/public key
# NUNCA commitar .env.local — gitignored na raiz.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY_HERE

# Apps consomem via:
#   apps/app (Vite):  VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY
#   apps/site (Next): NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY
