{
  "name": "@dojo-fs/supabase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Supabase client factory + types compartilhados (agnóstico Vite/Next)",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./middleware": "./src/middleware.ts",
    "./types": "./src/types.ts",
    "./queries/*": "./src/queries/*.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "2.106.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "next": "^15.1.4",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo '(lint delegated to consumer apps)'",
    "gen-types": "echo 'Run after T8 with: supabase gen types typescript --linked > src/types.ts'"
  }
}
