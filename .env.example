# ============================================================================
# .env.example — template das variáveis do dojo-familia-scholze
# ============================================================================
# COPIE este arquivo pra .env.local (gitignored) e preencha com valores reais.
#
# CONVENÇÃO CANÔNICA KOD.AI: tudo do sistema fica DENTRO do repo do sistema.
# Public + admin keys ficam aqui (gitignored). Não espalha em pastas externas.
# ============================================================================

# ========== PUBLIC: app runtime (vai pro browser) ==========
# Anon key é pública por design — rate-limited + respeita RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY_HERE
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY_HERE

# ========== ADMIN: tooling local + CI (NUNCA no browser) ==========
# Personal Access Token — Management API. Gerar em supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_YOUR_ACCESS_TOKEN_HERE

# Project ref (atalho pra scripts/tooling)
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Vercel Access Token — Management API (criar/configurar projects, env vars).
# Gerar em vercel.com/account/tokens (scope Full Account)
VERCEL_TOKEN=vcp_YOUR_TOKEN_HERE

# ========== ADMIN OPCIONAL ==========
# service_role — bypass RLS. SÓ pra Edge Functions / scripts admin server-side.
SUPABASE_SERVICE_ROLE_KEY=

# DB password do Postgres — psql/CLI. Pega da criação do project.
SUPABASE_DB_PASSWORD=

# ========== APP CONFIG ==========
# Site URL — Magic Link auth redirectTo + Open Graph metadataBase do Next.js.
# Em prod: URL canônica do Vercel/domínio. Em dev local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://yourdomain.com.br
