# =====================================================================
# .env.example — template das variáveis de ambiente Dojô Família Scholze
# =====================================================================
# COPIE este arquivo pra .env.local (gitignored) e preencha com valores reais.
# Apps consomem via:
#   - apps/site (Next.js)  → NEXT_PUBLIC_* (acessível no browser) + sem prefixo (server-only)
#   - apps/app (Vite)      → VITE_*        (acessível no browser)

# ---------- Supabase ----------
# Project URL — Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon/public key — Project Settings > API > Project API keys > anon/public
# É segura no browser (rate-limited + respeita RLS). Pode ser pública.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY_HERE
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY_HERE

# service_role key — NUNCA COMMITAR. NUNCA NO BROWSER.
# Bypass total de RLS. Só usar em Edge Functions / admin scripts server-side.
# SUPABASE_SERVICE_ROLE_KEY=...

# ---------- Site URL (Next.js Open Graph + metadataBase) ----------
# Em dev local fica vazio (cai pra localhost:3000). Em Vercel é setada automática.
# NEXT_PUBLIC_SITE_URL=https://dojofamiliascholze.com.br
